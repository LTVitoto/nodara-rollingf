# ─────────────────────────────────────────────────────────────────────────────
# Nodara Rolling Forecast · plantilla de entorno → `make env` genera .env con secretos aleatorios.
# .env NUNCA se versiona. Los valores de abajo son solo para la simulación local.
# ─────────────────────────────────────────────────────────────────────────────

# Puertos publicados en el host (siempre bind 127.0.0.1). Si `make preflight`
# detecta colisión (p. ej. PostgreSQL nativo de Windows en 5432), cámbialos aquí.
S4_DB_PORT=5432
VECTOR_DB_PORT=5433
FRONTEND_PORT=3000
TRINO_PORT=8080
UNITY_CATALOG_PORT=8081
DEBEZIUM_PORT=8083
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LANGFUSE_PORT=3001

# Capa transaccional · SAP S/4HANA simulado
S4_DB_ADMIN_USER=s4admin
S4_DB_ADMIN_PASSWORD=change-me-s4admin
S4_DEBEZIUM_PASSWORD=change-me-debezium
S4_TRINO_PASSWORD=change-me-trino

# Base de conocimiento · pgvector (aislada: solo bitácoras)
VECTOR_DB_USER=kbadmin
VECTOR_DB_PASSWORD=change-me-kbadmin

# Lakehouse · MinIO (root = administración; service account = Trino + delta-sink)
MINIO_ROOT_USER=nodara-root
MINIO_ROOT_PASSWORD=change-me-minio-root
LAKEHOUSE_S3_ACCESS_KEY=lakehouse-svc
LAKEHOUSE_S3_SECRET_KEY=change-me-lakehouse-svc

# IA local · Ollama: embeddings + motor de contingencia (se importan vía `make models`)
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# IA cloud · NVIDIA NIM (motor por defecto). Pegar la API key SOLO en .env (nunca en git).
# Sale del enclave únicamente por egress-proxy (allowlist en egress/allowlist.txt).
# El modelo se cambia solo con NIM_MODEL, después de probarlo con una llamada real.
LLM_DEFAULT_ENGINE=nim
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=openai/gpt-oss-20b
NIM_TIMEOUT_S=45
NIM_REASONING_EFFORT=low

# Observabilidad GenAI · Langfuse v2 autoalojado (UI en http://localhost:LANGFUSE_PORT).
# `make env` genera las claves (pk-lf-… / sk-lf-…) y los secretos.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_ADMIN_EMAIL=admin@nodara.local
LANGFUSE_ADMIN_PASSWORD=change-me-langfuse-admin
LANGFUSE_DB_PASSWORD=change-me-langfuse-db
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth
LANGFUSE_SALT=change-me-langfuse-salt
TRACE_USER_ID=gerente_finanzas@nodara.com

# GPU NVIDIA opcional: descomenta para que Ollama use la GPU (requiere runtime nvidia).
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
